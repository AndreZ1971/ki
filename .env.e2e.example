# E2E Test Environment Variables

# Base URL für Tests (wird überschrieben durch playwright.config.ts)
BASE_URL=http://localhost:5173

# Test User Credentials
# Diese Credentials müssen in deiner Test-Datenbank existieren
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test123!

# Admin User (für Admin-spezifische Tests)
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=Admin123!

# API Base URL (für API-Tests)
API_BASE_URL=http://localhost:3000

# Test-Modus (skip externe API calls)
TEST_MODE=true

# Timeouts (in milliseconds)
PAGE_LOAD_TIMEOUT=30000
ACTION_TIMEOUT=10000

# Screenshots & Videos
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true

# CI Environment
CI=false
