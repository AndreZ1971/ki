# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ARI - Artificial Retail Intelligence - Environment Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ========================================
# Database Configuration
# ========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# ========================================
# OpenAI Configuration (für KI/ML Features)
# ========================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# ========================================
# 🚨 EMERGENCY ALERTING CONFIGURATION
# ========================================

# Slack Emergency Webhook
# Erstelle einen Incoming Webhook: https://api.slack.com/messaging/webhooks
# Format: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_EMERGENCY_WEBHOOK=

# Emergency Alert Email
# Email-Adresse für kritische Payment-Notfälle (P0/P1)
EMERGENCY_ALERT_EMAIL=devops@your-company.com

# PagerDuty Integration Key
# Für P0/P1 Incidents wird automatisch PagerDuty getriggert
# Guide: https://support.pagerduty.com/docs/services-and-integrations
PAGERDUTY_INTEGRATION_KEY=

# ========================================
# WooCommerce Configuration
# ========================================
WP_URL=https://your-wordpress-site.com
WP_CONSUMER_KEY=ck_your_consumer_key_here
WP_CONSUMER_SECRET=cs_your_consumer_secret_here

# ========================================
# Server Configuration
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# Redis (Rate Limiting / Caching)
# ========================================
REDIS_URL=redis://localhost:6379

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_ALLOWLIST=127.0.0.1

# ========================================
# CORS Configuration
# ========================================
CORS_ORIGIN=http://localhost:5173

# ========================================
# Specialization Encryption
# ========================================
# AES-256 Encryption Key für Spezialisierungen (32 bytes)
# Generiere mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPEC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ========================================
# Social Media APIs (optional)
# ========================================
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# ========================================
# IFTTT/Zapier/Make.com (optional)
# ========================================
IFTTT_WEBHOOK_KEY=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=

# ========================================
# Logging & Monitoring
# ========================================
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false

# ========================================
# 📝 HINWEISE
# ========================================
# 1. Kopiere diese Datei zu .env und fülle die Werte aus
# 2. .env ist in .gitignore und wird NICHT committed
# 3. Für Production: Nutze sichere Environment Variables (z.B. Docker Secrets, Kubernetes Secrets)
# 4. SLACK_EMERGENCY_WEBHOOK: Notfälle werden als Rich Message mit Ticket-ID, Impact, Escalation gesendet
# 5. PAGERDUTY_INTEGRATION_KEY: Nur P0/P1 triggern PagerDuty-Incidents
# 6. EMERGENCY_ALERT_EMAIL: Nutzt dein bestehendes Email-System
