{
  "name": "ari-artificial-retail-intelligence-backend",
  "version": "7.4.0",
  "description": "Backend for A.R.I. Artificial Retail Intelligence System",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && npm run copy-module-alias",
    "copy-module-alias": "node -e \"require('fs').copyFileSync('module-alias.js', 'dist/module-alias.js')\"",
    "dev": "tsc && node --watch dist/server.js",
    "dev:agent": "tsx watch agent/planner.ts",
    "start": "node dist/server.js",
    "start:agent": "node dist/agent/planner.js",
    "start:jobs": "node dist/agent/jobs/index.js",
    "generate-admin-hash": "tsx scripts/generate-admin-hash.ts",
    "run:createFreebie": "tsx agent/jobs/runCreateFreebie.ts",
    "trend-analysis": "tsx agent/jobs/runTrendAnalysis.ts",
    "auto-product": "tsx agent/jobs/runAutoProductCreator.ts",
    "get-categories": "tsx agent/jobs/getCategories.ts",
    "test-german": "tsx -- agent/jobs/runAutoProductCreator.ts --keyword \"datenschutz\" --max-products 1 --min-score 40",
    "german-products": "tsx agent/jobs/germanContentGenerator.ts",
    "create-dsgvo": "tsx agent/jobs/germanContentGenerator.ts",
    "ai-products": "tsx agent/jobs/aiContentGenerator.ts",
    "create-ai": "tsx agent/jobs/aiContentGenerator.ts",
    "generate-images": "tsx agent/jobs/aiImageGenerator.ts",
    "ai-images": "tsx agent/jobs/aiImageGenerator.ts",
    "social-media": "tsx agent/jobs/socialMediaAutomation.ts",
    "generate-posts": "tsx agent/jobs/socialMediaAutomation.ts",
    "auto-post": "tsx agent/jobs/socialMediaAutoPoster.ts",
    "schedule-posts": "tsx agent/jobs/socialMediaAutoPoster.ts",
    "email-marketing": "tsx agent/jobs/emailMarketingAutomation.ts",
    "send-emails": "tsx agent/jobs/emailMarketingAutomation.ts",
    "generate-report": "tsx agent/jobs/analyticsReporting.ts",
    "analytics": "tsx agent/jobs/analyticsReporting.ts",
    "analytics-real": "tsx agent/jobs/realAnalyticsReporting.ts",
    "analytics-enhanced": "tsx agent/jobs/realAnalyticsReporting.ts",
    "conversion-report": "tsx agent/jobs/conversionReport.ts",
    "conversion-analysis": "tsx agent/jobs/conversionAnalysis.ts",
    "fix-conversion": "tsx agent/jobs/conversionReport.ts",
    "analytics:dev": "tsx watch agent/jobs/realAnalyticsReporting.ts",
    "conversion:dev": "tsx watch agent/jobs/conversionReport.ts",
    "fix-payments": "tsx agent/jobs/paymentFixer.ts",
    "fix-free-conversion": "tsx agent/jobs/freeToPaidConverter.ts",
    "monetize-content": "tsx agent/jobs/contentMonetizer.ts",
    "quick-fixes": "npm run fix-payments && npm run fix-free-conversion && npm run monetize-content",
    "health-report": "tsx agent/jobs/shopHealthReport.ts",
    "implement-fixes": "tsx agent/jobs/autoFixImplementer.ts",
    "full-analysis": "npm run conversion-report && npm run health-report && npm run implement-fixes",
    "debug-payments": "tsx agent/jobs/paymentDebugger.ts",
    "test-payments": "tsx agent/jobs/paymentTester.ts",
    "fix-payments-complete": "npm run debug-payments && npm run test-payments",
    "live-payment-fix": "tsx agent/jobs/paymentLiveFixer.ts",
    "payment-quick-check": "tsx agent/jobs/paymentQuickCheck.ts",
    "fix-payments-now": "npm run payment-quick-check && npm run live-payment-fix",
    "verify-payments": "tsx agent/jobs/paymentVerifier.ts",
    "payment-success": "tsx agent/jobs/paymentSuccess.ts",
    "payment-complete": "npm run verify-payments && npm run payment-success",
    "detect-payment-issues": "tsx agent/jobs/paymentIssueDetector.ts",
    "payment-companion": "tsx agent/jobs/paymentFixCompanion.ts",
    "fix-payments-critical": "npm run detect-payment-issues && npm run payment-companion",
    "payment-emergency": "tsx agent/jobs/paymentEmergency.ts",
    "validate-payment-success": "tsx agent/jobs/paymentSuccessValidator.ts",
    "ultimate-payment-fix": "npm run payment-emergency && npm run validate-payment-success",
    "_moduleAliases": {
      "@config": "./dist/config.js"
    },
    "simple-payment-fix": "tsx agent/jobs/paymentSimpleFix.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "encrypt:test-specializations": "tsx scripts/encrypt-test-specializations.ts",
    "verify:test-specializations": "tsx scripts/verify-test-specializations.ts",
    "db:migrate": "knex migrate:latest",
    "db:migrate:make": "knex migrate:make",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "clean": "rm -rf dist",
    "preview": "node dist/server.js",
    "prepare": "husky",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "typescript",
    "fastify",
    "openai",
    "api",
    "woocommerce",
    "analytics",
    "conversion"
  ],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.0.1",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/under-pressure": "^9.0.0",
    "@sinclair/typebox": "^0.34.41",
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "check-disk-space": "^3.3.1",
    "cheerio": "^1.0.0-rc.12",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-multer": "^2.0.3",
    "fastify-raw-body": "^5.0.0",
    "form-data": "^4.0.4",
    "google-trends-api": "^4.9.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "minimist": "^1.2.8",
    "module-alias": "^2.2.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "openai": "^6.15.0",
    "pino": "^10.0.0",
    "prom-client": "^15.0.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "twitter-api-v2": "^1.29.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/minimist": "^1.2.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "@types/sharp": "^0.31.1",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreZ1971/ki"
  }
}
