{
  "name": "ari-artificial-retail-intelligence-system",
  "version": "7.0.9",
  "description": "A.R.I. Artificial Retail Intelligence System – Real-time Analytics & AI Content Generation",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "dev": "tsx watch src/server.ts",
    "dev:agent": "tsx watch src/agent/planner.ts",
    "start": "node backend/dist/server.js",
    "start:agent": "node dist/agent/planner.js",
    "start:jobs": "node dist/agent/jobs/index.js",
    "run:createFreebie": "tsx src/agent/jobs/runCreateFreebie.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:ui-health": "npx tsx scripts/check-ui-health.ts",
    "test:ui-e2e": "playwright test tests/e2e/tools-ui-health.spec.ts",
    "test:ui-full": "npm run test:ui-health && npm run test:ui-e2e",
    "ui:check": "npm run test:ui-health",
    "ui:report": "playwright show-report",
    "db:migrate": "knex migrate:latest",
    "db:migrate:make": "knex migrate:make",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "clean": "rm -rf dist",
    "preview": "node dist/server.js",
    "prepare": "husky",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --quiet --fix"
  },
  "keywords": [
    "ai",
    "agent",
    "typescript",
    "fastify",
    "openai",
    "api"
  ],
  "author": "Your Name",
  "license": "ISC",
  "_moduleAliases": {
    "@config": "backend/dist/config.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/under-pressure": "^9.0.0",
    "@sinclair/typebox": "^0.34.46",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-raw-body": "^5.0.0",
    "form-data": "^4.0.5",
    "fs-extra": "^11.3.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "minimist": "^1.2.8",
    "module-alias": "^2.2.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "ioredis": "^5.4.1",
    "openai": "^6.15.0",
    "pino": "^10.0.0",
    "prom-client": "^15.0.0",
    "rss-parser": "^3.13.0",
    "yargs": "^18.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "your-repository-url"
  }
}
