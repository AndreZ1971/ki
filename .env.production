# ===========================
# Production Config für Hetzner
# ===========================

# Shop-Specific (für Multi-Tenant später)
SHOP_ID=kaufe-es
SHOP_NAME="Kaufe-Es.eu"

# WooCommerce Connection
WOOCOMMERCE_URL=https://kaufe-es.eu
WOOCOMMERCE_CONSUMER_KEY=<DEIN_KEY>
WOOCOMMERCE_CONSUMER_SECRET=<DEIN_SECRET>

# OpenAI API
OPENAI_API_KEY=<DEIN_OPENAI_KEY>

# Server Config
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<DEINE_EMAIL>
SMTP_PASS=<DEIN_APP_PASSWORD>

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# Sicherheit
ALLOWED_ORIGINS=https://kaufe-es.eu
CORS_ENABLED=true
